{
  "name": "spotify-recommender",
  "version": "0.1.0",
  "private": true,
  "description": "Claude Code から Spotify プレイリストにおすすめ曲を追加する MCP サーバー",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "auth": "node dist/auth.js",
    "start": "node dist/server.js",
    "review": "node dist/review-cli.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
